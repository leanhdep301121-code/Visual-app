<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Fill in whichever provider you have a key for. DeepSeek is preferred
         (cheaper + JSON mode works); Kimi is the fallback if DeepSeek is empty. -->
    <key>DEEPSEEK_API_KEY</key>
    <string></string>
    <key>KIMI_API_KEY</key>
    <string></string>
    <!-- 实时语音教练（多语言 TTS，中英都能说）。留空则退回系统语音 AVSpeech。 -->
    <key>ELEVENLABS_API_KEY</key>
    <string></string>
</dict>
</plist>
