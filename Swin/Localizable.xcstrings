            "value" : "At the top, feel your shoulders keep turning while your hips brace and hold — that stretch between them is your power."
          }
        }
      }
    },
    "顶点时上半身往目标方向倾" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upper body tilts toward the target at the top"
          }
        }
      }
    },
    "顶点时上半身没转够" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
